# 이 파일을 .env로 복사하고 실제 값을 넣으세요. .env는 업로드하지 마세요.
OPENAI_API_KEY=
# Optional: Gemini free tier (takes priority when set); never commit your real key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_MODEL=gpt-4.1-mini
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Render에서는 PATH 대신 FIREBASE_SERVICE_ACCOUNT_JSON에 JSON 내용 전체를 넣으세요.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:8001,http://127.0.0.1:8001
